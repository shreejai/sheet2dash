# Clerk — https://dashboard.clerk.com → API keys.
# Optional in local dev: without them Clerk runs in "keyless" mode with temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Neon Postgres — https://console.neon.tech → Connection string
DATABASE_URL=

# Google Cloud — OAuth client ID (also pasted into Clerk's Google connection),
# Picker API key, and the project number (Picker "app id")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# OpenAI — chat
OPENAI_API_KEY=
